---
// Todas las páginas (también la portada) salen de src/content/pages/*.json, con
// la misma URL que en WordPress y el mismo aspecto: el árbol de Elementor se pinta
// con sus clases y su fichero de estilos post-<id>.css.
import Base from '../layouts/Base.astro';
import Nodo from '../components/elementor/Nodo.astro';
import Resumen from '../components/Resumen.astro';
import { seoDe } from '../lib/seo';
import { migasDe } from '../lib/migas';

export async function getStaticPaths() {
  const files = import.meta.glob('../content/pages/*.json', { eager: true });
  return Object.values(files).map((mod: any) => mod.default).map((data: any) => {
    const ruta = new URL(data.url).pathname.replace(/^\/|\/$/g, '');
    return { params: { slug: ruta || undefined }, props: { data } };
  });
}

const { data } = Astro.props as { data: any };
const seo = seoDe(data.slug);
const h1 = data.blocks.find((b: any) => b.type === 'heading' && b.tag === 'h1');
const nombre = (h1?.text || data.title).replace(/<[^>]+>/g, '');
const r = data.resumen;
const datos = r ? [{ '@type': 'Service', serviceType: r.tipo, areaServed: r.area, description: r.descripcion, provider: { '@id': 'https://dearquitectura.info/#empresa' }, ...(r.imagen ? { image: `https://dearquitectura.info${r.imagen}` } : {}) }] : [];
---
<Base
  title={seo.titulo || data.title}
  description={seo.descripcion || data.meta_description}
  canonical={data.url}
  menu={data.menu}
  logo={data.logo}
  idPagina={data.legal ? undefined : data.id}
  imagen={seo.imagen}
  ogTitulo={seo.ogTitulo}
  ogDescripcion={seo.ogDescripcion}
  migas={migasDe(data.url, nombre)}
  indexar={!seo.noindex}
  datos={datos}
>
  {data.h1_es_titulo && <h1 class="h1-titulo">{data.title}</h1>}
  {data.legal ? (
    <>
      <h1 class="h1-titulo">{data.title}</h1>
      {data.html ? <Fragment set:html={data.html} /> : <p class="pendiente">Texto pendiente (Fase 4: se redacta con los datos reales del titular).</p>}
    </>
  ) : (
    <div data-elementor-type="wp-page" data-elementor-id={data.id} class={`elementor elementor-${data.id}`}>
      {data.elementor.map((n: any) => <Nodo n={n} blocks={data.blocks} />)}
    </div>
  )}
  {r && <Resumen r={r} />}
</Base>
