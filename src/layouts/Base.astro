---
// Plantilla de todas las páginas (diseño nuevo, 16-11-2026): barra superior,
// cabecera, migas, contenido y pie. Estilos: /diseno/base.css (todo el diseño) +
// /diseno/post-<id>.css (solo la colocación de cada página, sacada de Elementor).
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import type { Miga } from '../lib/migas';

interface Props {
  title: string;
  description?: string;
  canonical: string;
  menu?: string;
  logo?: string;
  idPagina?: string; // id de WordPress: elige el post-<id>.css de Elementor
  imagen?: string;
  ogTitulo?: string;
  ogDescripcion?: string;
  datos?: Record<string, unknown>[];
  migas?: Miga[];
  indexar?: boolean;
  fechas?: { publicada?: string; modificada?: string }; // de WordPress, para WebPage
  actualizada?: string; // ISO: fecha de actualización visible (solo artículos)
}
const { title, description = '', canonical, menu, logo, idPagina, imagen, ogTitulo, ogDescripcion, datos = [], migas = [], indexar = true, fechas, actualizada } = Astro.props as Props;
const fechaVisible = actualizada ? new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(actualizada)) : '';
const iso = (f?: string) => (f && /^\d{4}-\d\d-\d\d/.test(f) ? f.replace(' ', 'T') + 'Z' : undefined);
const dominio = `https://${site.dominio}`;
const ruta = canonical.replace(/^https?:\/\/[^/]+/, '') || '/';
const imagenAbsoluta = imagen ? (imagen.startsWith('http') ? imagen : `${dominio}${imagen}`) : '';
const noindex = !indexar || !site.indexar;

const empresa: Record<string, unknown> = {
  '@type': 'Organization', '@id': `${dominio}/#empresa`, name: site.nombre, url: `${dominio}/`,
  logo: { '@type': 'ImageObject', url: `${dominio}${site.logo.src}`, width: site.logo.w, height: site.logo.h },
  description: site.descripcion,
  ...(site.correo ? { email: site.correo } : {}),
  ...(site.telefono ? { telephone: site.telefono } : {}),
  ...(site.localidad ? { address: { '@type': 'PostalAddress', addressLocality: site.localidad, addressCountry: site.pais } } : {}),
};
const grafo: Record<string, unknown>[] = [
  empresa,
  { '@type': 'WebSite', '@id': `${dominio}/#web`, url: `${dominio}/`, name: site.nombre, inLanguage: 'es', publisher: { '@id': `${dominio}/#empresa` } },
  { '@type': 'WebPage', '@id': `${canonical}#pagina`, url: canonical, name: title, ...(description ? { description } : {}), isPartOf: { '@id': `${dominio}/#web` }, inLanguage: 'es', ...(iso(fechas?.publicada) ? { datePublished: iso(fechas?.publicada) } : {}), ...(iso(fechas?.modificada) ? { dateModified: iso(fechas?.modificada) } : {}), ...(migas.length > 1 ? { breadcrumb: { '@id': `${canonical}#migas` } } : {}) },
  ...(migas.length > 1 ? [{ '@type': 'BreadcrumbList', '@id': `${canonical}#migas`, itemListElement: migas.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.nombre, item: m.url })) }] : []),
  ...datos,
];
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo });
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {site.analytics.ga4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.ga4}`}></script>}
    {site.analytics.ga4 && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.analytics.ga4}');`} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {site.bing && <meta name="msvalidate.01" content={site.bing} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={ogTitulo || title} />
    {(ogDescripcion || description) && <meta property="og:description" content={ogDescripcion || description} />}
    <meta property="og:url" content={canonical} />
    {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
    <meta name="twitter:card" content={imagenAbsoluta ? 'summary_large_image' : 'summary'} />
    <link rel="preload" href="/diseno/fuentes/manrope.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/diseno/base.css" />
    {idPagina && <link rel="stylesheet" href={`/diseno/post-${idPagina}.css`} />}
    {site.analytics.adsense && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.analytics.adsense}`} crossorigin="anonymous"></script>}
    <script type="application/ld+json" set:html={jsonld} />
  </head>
  <body class={ruta === '/' ? 'portada' : undefined}>
    <a class="salto" href="#contenido">Ir al contenido</a>
    <Header menu={menu} ruta={ruta} />
    <main id="contenido" class="contenido">
      {migas.length > 1 && (
        <nav class="migas contenedor" aria-label="Estás en">
          {fechaVisible && <p class="actualizada">Actualizado el <time datetime={actualizada}>{fechaVisible}</time></p>}
          <ol>{migas.map((m, i) => <li>{i < migas.length - 1 ? <a href={m.url.replace(/^https?:\/\/[^/]+/, '')}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>)}</ol>
        </nav>
      )}
      <slot />
    </main>
    <Footer />
    <a href="#" class="subir" aria-label="Subir al principio de la página"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 10l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></a>
    <script is:inline src="/diseno/web.js" defer></script>
  </body>
</html>
