---
// Plantilla de todas las páginas: el mismo esqueleto que pinta WordPress con el
// tema OceanWP (barra superior, cabecera, <main>, <article>, pie) y los mismos
// estilos, en el mismo orden: antes.css → post-<id>.css de la página → despues.css.
// Lo propio de la web nueva (lo que en WordPress hacía JavaScript) va en propio.css.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import type { Miga } from '../lib/migas';

interface Props {
  title: string;
  description?: string;
  canonical: string;
  menu?: string;
  logo?: string;
  idPagina?: string; // id de WordPress: elige el post-<id>.css de Elementor
  imagen?: string;
  ogTitulo?: string;
  ogDescripcion?: string;
  datos?: Record<string, unknown>[];
  migas?: Miga[];
  indexar?: boolean;
}
const { title, description = '', canonical, menu, logo, idPagina, imagen, ogTitulo, ogDescripcion, datos = [], migas = [], indexar = true } = Astro.props as Props;
const dominio = `https://${site.dominio}`;
const ruta = canonical.replace(/^https?:\/\/[^/]+/, '') || '/';
const imagenAbsoluta = imagen ? (imagen.startsWith('http') ? imagen : `${dominio}${imagen}`) : '';
const noindex = !indexar || !site.indexar;
const clasesBody = [
  'wp-singular page-template-default page', ruta === '/' ? 'home' : '', idPagina ? `page-id-${idPagina}` : '',
  'wp-custom-logo wp-embed-responsive wp-theme-oceanwp oceanwp-theme dropdown-mobile boxed-layout default-breakpoint content-full-width content-max-width has-topbar page-header-disabled has-breadcrumbs elementor-default elementor-kit-7',
  idPagina ? `elementor-page elementor-page-${idPagina}` : '',
].filter(Boolean).join(' ');

const empresa: Record<string, unknown> = {
  '@type': 'Organization', '@id': `${dominio}/#empresa`, name: site.nombre, url: `${dominio}/`,
  logo: { '@type': 'ImageObject', url: `${dominio}${site.logo.src}`, width: site.logo.w, height: site.logo.h },
  description: site.descripcion,
  ...(site.correo ? { email: site.correo } : {}),
  ...(site.telefono ? { telephone: site.telefono } : {}),
};
const grafo: Record<string, unknown>[] = [
  empresa,
  { '@type': 'WebSite', '@id': `${dominio}/#web`, url: `${dominio}/`, name: site.nombre, inLanguage: 'es', publisher: { '@id': `${dominio}/#empresa` } },
  { '@type': 'WebPage', '@id': `${canonical}#pagina`, url: canonical, name: title, ...(description ? { description } : {}), isPartOf: { '@id': `${dominio}/#web` }, inLanguage: 'es', ...(migas.length > 1 ? { breadcrumb: { '@id': `${canonical}#migas` } } : {}) },
  ...(migas.length > 1 ? [{ '@type': 'BreadcrumbList', '@id': `${canonical}#migas`, itemListElement: migas.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.nombre, item: m.url })) }] : []),
  ...datos,
];
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo });
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {site.analytics.ga4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.ga4}`}></script>}
    {site.analytics.ga4 && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.analytics.ga4}');`} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {site.bing && <meta name="msvalidate.01" content={site.bing} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={ogTitulo || title} />
    {(ogDescripcion || description) && <meta property="og:description" content={ogDescripcion || description} />}
    <meta property="og:url" content={canonical} />
    {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
    <meta name="twitter:card" content={imagenAbsoluta ? 'summary_large_image' : 'summary'} />
    <link rel="stylesheet" href="/estilos/antes.css" />
    {idPagina && <link rel="stylesheet" href={`/estilos/uploads/elementor/css/post-${idPagina}.css`} />}
    <link rel="stylesheet" href="/estilos/despues.css" />
    <link rel="stylesheet" href="/estilos/propio.css" />
    {site.analytics.adsense && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.analytics.adsense}`} crossorigin="anonymous"></script>}
    <script type="application/ld+json" set:html={jsonld} />
  </head>
  <body class={clasesBody}>
    <div id="outer-wrap" class="site clr">
      <a class="skip-link screen-reader-text" href="#main">Ir al contenido</a>
      <div id="wrap" class="clr">
        <Header menu={menu} logo={logo} ruta={ruta} />
        <main id="main" class="site-main clr" role="main">
          <div id="content-wrap" class="container clr">
            <div id="primary" class="content-area clr">
              <div id="content" class="site-content clr">
                <article class="single-page-article clr">
                  <div class="entry clr">
                    <slot />
                  </div>
                </article>
              </div>
            </div>
          </div>
        </main>
        <Footer />
      </div>
    </div>
    <a aria-label="Hacer scroll a la parte superior de la página" href="#" id="scroll-top" class="scroll-top-right"><i class=" fa fa-angle-up" aria-hidden="true" role="img"></i></a>
    <script is:inline src="/estilos/propio.js" defer></script>
  </body>
</html>
