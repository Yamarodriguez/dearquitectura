---
// Enlaces a páginas del mismo tema al final de la página (src/data/relacionadas.json).
import relacionadas from '../data/relacionadas.json';
import articulos from '../data/articulos.json';
import menus from '../data/menus.json';
import popularidad from '../data/popularidad.json';
import { mapaPaises, paisDeCiudad } from '../lib/paises.mjs';
import { sinIndexar } from '../lib/indexar';

interface Props { slug: string; menu?: string }
const { slug, menu } = Astro.props as Props;
import { paginas } from '../lib/paginas';
const porSlug = new Map(paginas.map((p: any) => [p.slug, p]));
const bloques: { titulo: string; enlaces: { url: string; nombre: string }[] }[] = [];
const enlace = (s: string) => { const p: any = porSlug.get(s); return p ? { url: new URL(p.url).pathname, nombre: p.title } : null; };
for (const g of relacionadas.grupos) {
  const lista = (articulos as Record<string, any>)[g.de] as string[];
  if (lista?.includes(slug)) bloques.push({ titulo: g.titulo, enlaces: lista.filter((s) => s !== slug).map(enlace).filter(Boolean) as any });
}
// Renders por país (18-11-2026): cada ciudad enlaza a su país y a las ciudades más visitadas
// de ese país; cada país, a los demás países. Solo páginas que están en Google.
const mapa = mapaPaises(menus);
const { paises, paisDe } = mapa;
const visitas = (s: string) => { const v = (popularidad.paginas as Record<string, { clics: number; impresiones: number }>)[s]; return v ? v.clics * 1000 + v.impresiones : 0; };
const enGoogle = (s: string) => porSlug.has(s) && !sinIndexar.has(s);
const paisDeEsta = paises.some((p: any) => p.slug === slug) ? undefined : paisDeCiudad(slug, menu, mapa);
const nombrePais = (p: string) => paises.find((x: any) => x.slug === p)?.nombre ?? p;
if (paisDeEsta) {
  const hermanas = Object.entries(paisDe as Record<string, string>).filter(([c, p]) => p === paisDeEsta && c !== slug && enGoogle(c)).map(([c]) => c).sort((a, b) => visitas(b) - visitas(a)).slice(0, 8);
  bloques.push({ titulo: `Renders en ${nombrePais(paisDeEsta)}`, enlaces: [paisDeEsta, ...hermanas].map(enlace).filter(Boolean) as any });
} else if (paises.some((p: any) => p.slug === slug)) {
  const otros = paises.map((p: any) => p.slug).filter((p: string) => p !== slug && enGoogle(p)).sort((a: string, b: string) => visitas(b) - visitas(a)).slice(0, 12);
  bloques.push({ titulo: 'Renders en otros países', enlaces: otros.map(enlace).filter(Boolean) as any });
}
const extra = (relacionadas.extra as Record<string, { titulo: string; paginas: string[] }>)[slug];
if (extra) bloques.push({ titulo: extra.titulo, enlaces: extra.paginas.map(enlace).filter(Boolean) as any });
---
{bloques.map((b) => (
  <nav class="relacionadas" aria-label={b.titulo}>
    <h2>{b.titulo}</h2>
    <ul>{b.enlaces.map((e) => <li><a href={e.url}>{e.nombre}</a></li>)}</ul>
  </nav>
))}
