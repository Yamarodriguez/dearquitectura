---
// Barra superior y cabecera de OceanWP, con el mismo marcado que la web viva
// (para que sus estilos se apliquen igual): logo (cada página el suyo, como en
// WordPress), menú de escritorio con desplegables y menú de móvil.
// El menú de cada página sale de src/data/menus.json.
import menusData from '../data/menus.json';
import site from '../data/site.json';
import medidas from '../data/imagenes.json';

interface Props { menu?: string; logo?: string; ruta: string }
const { menu, logo, ruta } = Astro.props as Props;
const menus = menusData as Record<string, any[]>;
const items = menus[menu || 'principal'] ?? menus.principal;
const srcLogo = logo || site.logo.src;
const m = (medidas as Record<string, { w: number; h: number }>)[srcLogo];
const actual = (u: string) => u === ruta;
---
<div id="top-bar-wrap" class="clr">
  <div id="top-bar" class="clr container">
    <div id="top-bar-inner" class="clr">
      <div id="top-bar-content" class="clr has-content top-bar-centered">
        <span class="topbar-content">{site.correo}</span>
      </div>
    </div>
  </div>
</div>
<header id="site-header" class="minimal-header clr" data-height="125" role="banner">
  <div id="site-header-inner" class="clr container">
    <div id="site-logo" class="clr">
      <div id="site-logo-inner" class="clr">
        <a href="/" class="custom-logo-link" rel="home"><img fetchpriority="high" width={m?.w ?? site.logo.w} height={m?.h ?? site.logo.h} src={srcLogo} class="custom-logo" alt={site.logo.alt} decoding="async" /></a>
      </div>
    </div>
    <div id="site-navigation-wrap" class="clr">
      <nav id="site-navigation" class="navigation main-navigation clr" role="navigation" aria-label="Menú principal">
        <ul class="main-menu dropdown-menu sf-menu">
          {items.map((i: any) => (
            <li class={`menu-item${i.children?.length ? ' menu-item-has-children dropdown' : ''}${actual(i.url) ? ' current-menu-item' : ''}`}>
              <a href={i.url} class="menu-link"><span class="text-wrap">{i.label}{i.children?.length > 0 && <i class="nav-arrow fa fa-angle-down" aria-hidden="true" role="img"></i>}</span></a>
              {i.children?.length > 0 && (
                <ul class="sub-menu">
                  {i.children.map((c: any) => (
                    <li class={`menu-item${c.children?.length ? ' menu-item-has-children dropdown' : ''}${actual(c.url) ? ' current-menu-item' : ''}`}>
                      <a href={c.url} class="menu-link"><span class="text-wrap">{c.label}{c.children?.length > 0 && <i class="nav-arrow fa fa-angle-right" aria-hidden="true" role="img"></i>}</span></a>
                      {c.children?.length > 0 && (
                        <ul class="sub-menu">
                          {c.children.map((d: any) => (
                            <li class={`menu-item${actual(d.url) ? ' current-menu-item' : ''}`}><a href={d.url} class="menu-link"><span class="text-wrap">{d.label}</span></a></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="oceanwp-mobile-menu-icon clr mobile-right">
      <a href="#mobile-menu-toggle" class="mobile-menu" aria-label="Menú móvil" aria-expanded="false" aria-controls="mobile-dropdown">
        <i class="fa fa-bars" aria-hidden="true"></i>
        <span class="oceanwp-text">Menú</span>
        <span class="oceanwp-close-text">Cerrar</span>
      </a>
    </div>
  </div>
  <div id="mobile-dropdown" class="clr">
    <nav class="clr" aria-label="Menú móvil">
      <ul class="menu">
        {items.map((i: any) => (
          <li class={`menu-item${i.children?.length ? ' menu-item-has-children' : ''}`}>
            <a href={i.url}>{i.label}{i.children?.length > 0 && <span class="dropdown-toggle" tabindex="0" role="button" aria-label="Abrir submenú"></span>}</a>
            {i.children?.length > 0 && (
              <ul class="sub-menu">
                {i.children.map((c: any) => (
                  <li class={`menu-item${c.children?.length ? ' menu-item-has-children' : ''}`}>
                    <a href={c.url}>{c.label}{c.children?.length > 0 && <span class="dropdown-toggle" tabindex="0" role="button" aria-label="Abrir submenú"></span>}</a>
                    {c.children?.length > 0 && (
                      <ul class="sub-menu">{c.children.map((d: any) => <li class="menu-item"><a href={d.url}>{d.label}</a></li>)}</ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
