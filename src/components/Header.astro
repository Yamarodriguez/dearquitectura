---
// Barra superior (correo) y cabecera fija: logo, menú con desplegables en
// ordenador y menú a pantalla completa en el móvil (con su propio scroll).
// El menú de cada página sale de src/data/menus.json, como en WordPress.
import menusData from '../data/menus.json';
import site from '../data/site.json';
import diseno from '../data/diseno.json';
import { ajustarMenu } from '../lib/paises.mjs';
import { sinIndexar } from '../lib/indexar';

interface Props { menu?: string; ruta: string }
const { menu, ruta } = Astro.props as Props;
const menus = menusData as Record<string, any[]>;
// Menú ajustado (18-11-2026): sin las páginas que no están en Google y, en el de Renders, «Zonas» solo con los países
const nombreMenu = menus[menu || 'principal'] ? (menu || 'principal') : 'principal';
const items = ajustarMenu(nombreMenu, menus[nombreMenu], sinIndexar);
const clase = (i: any) => [i.url === ruta ? 'actual' : '', i.url === '/contacto/' ? 'contacto' : ''].filter(Boolean).join(' ') || undefined;
const flecha = '<svg class="flecha" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3.5 5 7.5 9 3.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
---
<div class="barra">
  <div class="contenedor"><span class="barra-lema">{diseno.lema}</span><a href={`mailto:${site.correo}`}>{site.correo}</a></div>
</div>
<header class="cabecera">
  <div class="contenedor">
    <a href="/" class="logo" aria-label={`${site.nombre}, inicio`}><img src="/diseno/logo.png" width="312" height="168" alt={site.logo.alt} fetchpriority="high" decoding="async" /></a>
    <nav class="menu-principal" aria-label="Menú principal">
      <ul>
        {items.map((i: any) => (
          <li class={clase(i)}>
            <a href={i.url}>{i.label}{i.children?.length > 0 && <Fragment set:html={flecha} />}</a>
            {i.children?.length > 0 && (
              <ul class="sub">
                {i.children.map((c: any) => (
                  <li class={clase(c)}>
                    <a href={c.url}>{c.label}{c.children?.length > 0 && <Fragment set:html={flecha.replace('M1 3.5 5 7.5 9 3.5', 'M3.5 1 7.5 5 3.5 9')} />}</a>
                    {c.children?.length > 0 && (
                      <ul class="sub">{c.children.map((d: any) => <li class={clase(d)}><a href={d.url}>{d.label}</a></li>)}</ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <button class="boton-menu" type="button" aria-expanded="false" aria-controls="menu-movil">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.8" fill="none"/></svg>
      <span>Menú</span>
    </button>
  </div>
</header>
<nav id="menu-movil" class="menu-movil" aria-label="Menú móvil">
  <ul>
    {items.map((i: any) => (
      <li>
        <div class="fila"><a href={i.url}>{i.label}</a>{i.children?.length > 0 && <button class="abrir" type="button" aria-expanded="false" aria-label={`Abrir ${i.label}`}><Fragment set:html={flecha} /></button>}</div>
        {i.children?.length > 0 && (
          <ul class="sub">
            {i.children.map((c: any) => (
              <li>
                <div class="fila"><a href={c.url}>{c.label}</a>{c.children?.length > 0 && <button class="abrir" type="button" aria-expanded="false" aria-label={`Abrir ${c.label}`}><Fragment set:html={flecha} /></button>}</div>
                {c.children?.length > 0 && <ul class="sub">{c.children.map((d: any) => <li><div class="fila"><a href={d.url}>{d.label}</a></div></li>)}</ul>}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>
