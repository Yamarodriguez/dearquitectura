---
// Ficha «Resumen» del servicio (la caja del plugin All In One Schema del original,
// en las páginas de estudio por ciudad), con el diseño nuevo. Mismos datos y etiquetas.
import medidas from '../data/imagenes.json';
interface Props { r: { imagen: string; tipo: string; proveedor: string; area: string; descripcion: string } }
const { r } = Astro.props as Props;
const m = (medidas as Record<string, { w: number; h: number }>)[r.imagen];
const alto = m ? Math.round((180 * m.h) / m.w) : undefined;
---
<aside class="resumen" aria-labelledby="resumen-titulo">
  <div>
    <h2 id="resumen-titulo">Resumen</h2>
    {r.imagen && m && <img width="180" height={alto} src={r.imagen} alt={r.tipo} loading="lazy" decoding="async" />}
    <dl>
      <dt>Tipo de servicio</dt><dd>{r.tipo}</dd>
      {r.proveedor && <><dt>Proveedor</dt><dd>{r.proveedor}</dd></>}
      {r.area && <><dt>Zona</dt><dd>{r.area}</dd></>}
      {r.descripcion && <><dt>Descripción</dt><dd>{r.descripcion}</dd></>}
    </dl>
  </div>
</aside>
