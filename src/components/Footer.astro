---
// Pie: logo con la descripción del estudio, las tres columnas de enlaces del pie
// original y los enlaces legales.
import site from '../data/site.json';
const columnas: [string, [string, string][]][] = [
  ['Arquitectura', [['/', 'Arquitectura'], ['/arquitectos/', 'Arquitectos'], ['/estudio-de-arquitectura/', 'Estudio de Arquitectura'], ['/plataforma-arquitectura/', 'Plataforma Arquitectura']]],
  ['Renders y 3D', [['/renders/', 'Renders'], ['/planos/', 'Planos'], ['/modelado-3d/', 'Modelado 3D'], ['/tour-virtual/', 'Tour Virtual']]],
  ['Estudio', [['/proyectos-de-arquitectura/', 'Proyectos'], ['/servicios-de-arquitectura/', 'Servicios'], ['/contacto/', 'Contacto']]],
];
const legal = [['/politica-de-cookies/', 'Política de Cookies'], ['/politica-de-privacidad/', 'Política de Privacidad'], ['/aviso-legal/', 'Aviso Legal']];
---
<footer class="pie">
  <div class="contenedor">
    <div>
      <a href="/" class="logo-pie"><img loading="lazy" decoding="async" width="670" height="372" src="/img/2023/12/de-arquitectura-.png" alt={site.nombre} /></a>
      <p>{site.descripcion}</p>
      <p><a href={`mailto:${site.correo}`}>{site.correo}</a></p>
    </div>
    {columnas.map(([titulo, enlaces]) => (
      <div>
        <h2>{titulo}</h2>
        <ul>{enlaces.map(([u, t]) => <li><a href={u}>{t}</a></li>)}</ul>
      </div>
    ))}
  </div>
  <div class="legal">
    <div class="contenedor">
      <span>DeArquitectura.info</span>
      <ul>{legal.map(([u, t]) => <li><a href={u}>{t}</a></li>)}</ul>
    </div>
  </div>
</footer>
