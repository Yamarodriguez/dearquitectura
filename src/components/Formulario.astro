---
// Formulario de contacto: el mismo marcado, campos y textos que el Contact Form 7
// de la web viva (para que se vea igual con sus estilos), enviado con Netlify Forms
// sin salir de la página. Avisos y validación como Contact Form 7: estados
// init → submitting → sent / failed / invalid / unaccepted, mensajes en rojo bajo cada
// campo y el recuadro de respuesta de colores.
// - Antispam: campo trampa (netlify-honeypot) + el filtro de Netlify.
// - Sin JavaScript: los campos llevan «required» (el navegador avisa) y el envío
//   normal lleva a /gracias/ (noindex).
// - El aviso por correo (a arquitectura@dearquitectura.info) se configura en Netlify
//   (Formularios → Notificaciones).
---
<div class="wpcf7 no-js" lang="es-ES" dir="ltr">
<form name="contacto" method="post" action="/gracias/" class="wpcf7-form init" aria-label="Formulario de contacto" data-status="init" data-netlify="true" netlify-honeypot="campo-trampa" data-formulario>
<input type="hidden" name="form-name" value="contacto" />
<input type="hidden" name="pagina" value="" data-pagina />
<p class="campo-trampa" hidden><input name="campo-trampa" tabindex="-1" autocomplete="off" aria-hidden="true" /></p>
<p><label> Tu nombre<br />
<span class="wpcf7-form-control-wrap" data-name="your-name"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required" autocomplete="name" aria-required="true" aria-invalid="false" required type="text" name="your-name" /></span> </label>
</p>
<p><label> Tu correo electrónico<br />
<span class="wpcf7-form-control-wrap" data-name="your-email"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email" autocomplete="email" aria-required="true" aria-invalid="false" required type="email" name="your-email" /></span> </label>
</p>
<p><label> Telefono<br />
<span class="wpcf7-form-control-wrap" data-name="tel-477"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-tel wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-tel" autocomplete="tel" aria-required="true" aria-invalid="false" required type="tel" name="tel-477" /></span> </label>
</p>
<p><label> Zona, Lugar, Provincia<br />
<span class="wpcf7-form-control-wrap" data-name="Zona"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required" aria-required="true" aria-invalid="false" required type="text" name="Zona" /></span> </label>
</p>
<p><label> Tu mensaje (opcional)<br />
<span class="wpcf7-form-control-wrap" data-name="your-message"><textarea cols="40" rows="10" maxlength="2000" class="wpcf7-form-control wpcf7-textarea" aria-invalid="false" name="your-message"></textarea></span> </label>
</p>
<p><label> <span class="wpcf7-form-control-wrap" data-name="Polticadeprivacidad"><span class="wpcf7-form-control wpcf7-acceptance"><span class="wpcf7-list-item"><input type="checkbox" name="Polticadeprivacidad" value="1" aria-invalid="false" required /></span></span></span> He leido y acepto la <a href="/politica-de-privacidad/">politica de privacidad</a><br />
<input class="wpcf7-form-control wpcf7-submit has-spinner" type="submit" value="Enviar" /></label>
</p><div class="wpcf7-response-output" aria-hidden="true"></div>
</form>
</div>
<script>
  // Textos de Contact Form 7 en español (los mismos que veía el visitante en WordPress).
  const TXT = {
    obligatorio: 'Por favor, rellena este campo.',
    correo: 'Por favor, introduce una dirección de correo electrónico.',
    telefono: 'Por favor, introduce un número de teléfono.',
    aceptar: 'Debes aceptar los términos y condiciones antes de enviar tu mensaje.',
    invalido: 'Uno o más campos tienen un error. Por favor, revisa e inténtalo de nuevo.',
    enviado: 'Gracias por tu mensaje. Ha sido enviado.',
    fallo: 'Hubo un error intentando enviar tu mensaje. Por favor, inténtalo de nuevo más tarde.',
  };
  document.querySelectorAll<HTMLFormElement>('form[data-formulario]').forEach((form) => {
    form.noValidate = true; // con JavaScript, avisos como Contact Form 7 en vez de los del navegador
    form.parentElement?.classList.replace('no-js', 'js');
    const salida = form.querySelector<HTMLElement>('.wpcf7-response-output')!;
    const pagina = form.querySelector<HTMLInputElement>('[data-pagina]');
    const boton = form.querySelector<HTMLInputElement>('input[type="submit"]');
    if (pagina) pagina.value = location.href;

    const estado = (e: string, texto = '') => {
      form.className = form.className.replace(/\b(init|submitting|sent|failed|invalid|unaccepted|spam)\b/g, '').trim() + ' ' + e;
      form.dataset.status = e;
      salida.textContent = texto;
      salida.setAttribute('aria-hidden', texto ? 'false' : 'true');
      if (texto) salida.setAttribute('role', 'alert');
    };
    const limpiar = () => {
      form.querySelectorAll('.wpcf7-not-valid-tip').forEach((t) => t.remove());
      form.querySelectorAll('.wpcf7-not-valid').forEach((c) => { c.classList.remove('wpcf7-not-valid'); c.setAttribute('aria-invalid', 'false'); });
    };
    const marcar = (campo: HTMLInputElement | HTMLTextAreaElement, texto: string) => {
      campo.classList.add('wpcf7-not-valid');
      campo.setAttribute('aria-invalid', 'true');
      const tip = document.createElement('span');
      tip.className = 'wpcf7-not-valid-tip'; tip.setAttribute('aria-hidden', 'true'); tip.textContent = texto;
      campo.closest('.wpcf7-form-control-wrap')?.appendChild(tip);
    };
    const validar = (): 'ok' | 'invalid' | 'unaccepted' => {
      limpiar();
      let mal = false;
      form.querySelectorAll<HTMLInputElement>('.wpcf7-validates-as-required').forEach((c) => {
        const v = c.value.trim();
        if (!v) { marcar(c, TXT.obligatorio); mal = true; }
        else if (c.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) { marcar(c, TXT.correo); mal = true; }
        else if (c.type === 'tel' && !/^[+()\d\s.-]{6,}$/.test(v)) { marcar(c, TXT.telefono); mal = true; }
      });
      if (mal) return 'invalid';
      const acepta = form.querySelector<HTMLInputElement>('input[name="Polticadeprivacidad"]');
      return acepta && !acepta.checked ? 'unaccepted' : 'ok';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const v = validar();
      if (v === 'invalid') { estado('invalid', TXT.invalido); form.querySelector<HTMLElement>('.wpcf7-not-valid')?.focus(); return; }
      if (v === 'unaccepted') { estado('unaccepted', TXT.aceptar); return; }
      estado('submitting');
      if (boton) boton.disabled = true;
      try {
        const datos = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        const r = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: datos.toString() });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        if (pagina) pagina.value = location.href;
        estado('sent', TXT.enviado);
      } catch {
        estado('failed', TXT.fallo);
      }
      if (boton) boton.disabled = false;
    });
  });
</script>
