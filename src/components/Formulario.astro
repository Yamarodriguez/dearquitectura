---
// Formulario de contacto: el mismo marcado, campos y textos que el Contact Form 7
// de la web viva (para que se vea igual con sus estilos). Fase 5: se envía con
// Netlify Forms sin salir de la página; el aviso por correo (a
// arquitectura@dearquitectura.info) se configura en Netlify. Sin JavaScript, el
// envío normal lleva a /gracias/.
---
<div class="wpcf7 no-js" lang="es-ES" dir="ltr">
<form name="contacto" method="post" action="/gracias/" class="wpcf7-form init" aria-label="Formulario de contacto" data-netlify="true" netlify-honeypot="campo-trampa" data-formulario>
<input type="hidden" name="form-name" value="contacto" />
<input type="hidden" name="pagina" value="" data-pagina />
<p class="campo-trampa" hidden><input name="campo-trampa" tabindex="-1" autocomplete="off" aria-hidden="true" /></p>
<p><label> Tu nombre<br />
<span class="wpcf7-form-control-wrap" data-name="your-name"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required" autocomplete="name" aria-required="true" type="text" name="your-name" /></span> </label>
</p>
<p><label> Tu correo electrónico<br />
<span class="wpcf7-form-control-wrap" data-name="your-email"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email" autocomplete="email" aria-required="true" type="email" name="your-email" /></span> </label>
</p>
<p><label> Telefono<br />
<span class="wpcf7-form-control-wrap" data-name="tel-477"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-tel wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-tel" autocomplete="tel" aria-required="true" type="tel" name="tel-477" /></span> </label>
</p>
<p><label> Zona, Lugar, Provincia<br />
<span class="wpcf7-form-control-wrap" data-name="Zona"><input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required" aria-required="true" type="text" name="Zona" /></span> </label>
</p>
<p><label> Tu mensaje (opcional)<br />
<span class="wpcf7-form-control-wrap" data-name="your-message"><textarea cols="40" rows="10" maxlength="2000" class="wpcf7-form-control wpcf7-textarea" name="your-message"></textarea></span> </label>
</p>
<p><label> <span class="wpcf7-form-control-wrap" data-name="Polticadeprivacidad"><span class="wpcf7-form-control wpcf7-acceptance"><span class="wpcf7-list-item"><input type="checkbox" name="Polticadeprivacidad" value="1" /></span></span></span> He leido y acepto la <a href="/politica-de-privacidad/">politica de privacidad</a><br />
<input class="wpcf7-form-control wpcf7-submit has-spinner" type="submit" value="Enviar" /></label>
</p><div class="wpcf7-response-output" role="status" aria-live="polite" hidden></div>
</form>
</div>
<script>
  // Envío sin salir de la página, con el aviso donde lo pone Contact Form 7.
  document.querySelectorAll<HTMLFormElement>('form[data-formulario]').forEach((form) => {
    const aviso = form.querySelector<HTMLElement>('.wpcf7-response-output');
    const pagina = form.querySelector<HTMLInputElement>('[data-pagina]');
    const boton = form.querySelector<HTMLInputElement>('input[type="submit"]');
    if (pagina) pagina.value = location.href;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (boton) { boton.disabled = true; boton.value = 'Enviando…'; }
      const mostrar = (texto: string, ok: boolean) => {
        if (!aviso) return;
        aviso.hidden = false;
        form.dataset.status = ok ? 'sent' : 'failed';
        form.classList.remove('init'); form.classList.add(ok ? 'sent' : 'failed');
        aviso.textContent = texto;
      };
      try {
        const datos = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        const r = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: datos.toString() });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        mostrar('Gracias por tu mensaje. Ha sido enviado.', true);
      } catch {
        mostrar('Hubo un error intentando enviar tu mensaje. Por favor, inténtalo de nuevo más tarde.', false);
      }
      if (boton) { boton.disabled = false; boton.value = 'Enviar'; }
    });
  });
</script>
