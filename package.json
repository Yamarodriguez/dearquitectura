{
  "name": "dearquitectura",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "extraer": "node --max-old-space-size=4096 scripts/extraer-xml.mjs",
    "bajar:referencia": "node scripts/bajar-referencia.mjs",
    "bajar:fotos": "node scripts/bajar-fotos.mjs",
    "medidas": "node scripts/medidas-imagenes.mjs",
    "menus": "node scripts/menus-desde-referencia.mjs",
    "seo": "node scripts/seo-desde-referencia.mjs",
    "generar": "npm run extraer && npm run menus && npm run seo && node scripts/estilos-diseno.mjs",
    "todo": "node scripts/todo.mjs",
    "todo:visual": "node scripts/visual.mjs",
    "estilos": "node scripts/bajar-estilos.mjs && node scripts/estilos-diseno.mjs",
    "comprobar:web": "node scripts/comprobar-web.mjs"
  },
  "dependencies": {
    "astro": "4.16.7"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
